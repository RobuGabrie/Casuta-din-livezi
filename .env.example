# Copy to .env.local (development) or set on the server (production).
# See docs/notifications.md for how to get each value.

# WhatsApp alerts through CallMeBot (free, personal use).
# The key the CallMeBot bot sends back after activation.
CALLMEBOT_APIKEY=
# Number that receives the alerts, with country code. Defaults to the site's phone.
CALLMEBOT_PHONE=40751425215

# Email copy of each request (SMTP; for Gmail use an app password, not the real password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where requests are emailed. Defaults to the site's email (robumihaela69@gmail.com).
NOTIFY_EMAIL=

# 1 = print requests to the server log instead of sending them (testing).
# Defaults to on under `npm run dev` and off in production.
RESERVATIONS_DRY_RUN=
